# ============================================================
# ml-affiliate-agent — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# ============================================================

# --- Agente ---
# Porta da API REST do agente
AGENT_PORT=3001
# Token estático que o dashboard usa para autenticar na API do agente.
# Gere um valor longo e aleatório: openssl rand -hex 32
AGENT_TOKEN=troque-por-um-token-aleatorio

# Caminho do arquivo SQLite (relativo ao apps/agent ou absoluto)
DATABASE_PATH=./data/agent.sqlite

# Chave usada para criptografar cookies de sessão do portal de afiliados em disco.
# Gere: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria

# --- LLM (BYOK) ---
# Chave da Gemini API (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelo usado para ranking e composição de mensagens
LLM_MODEL=gemini-2.5-flash

# --- Mercado Livre (API oficial) ---
# Crie um app em https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Preenchido automaticamente após o primeiro OAuth (refresh token)
ML_REFRESH_TOKEN=
# Etiqueta de afiliado usada no linkbuilder (veja "Etiqueta em uso" no portal, ex.: abcd1234567)
# Obrigatória para gerar links. Também configurável pelo dashboard (Credenciais).
ML_AFFILIATE_TAG=

# --- Evolution API (WhatsApp) ---
# URL da Evolution. Em DEV local (porta publicada): http://localhost:8080
# Em PRODUÇÃO / docker compose (rede interna): http://evolution:8080
# Nunca use localhost dentro do container do agente — ele não alcança a Evolution.
EVOLUTION_URL=http://localhost:8080
# Chave de API da Evolution (defina a mesma no container)
EVOLUTION_API_KEY=troque-por-uma-chave-aleatoria
# Nome da instância WhatsApp na Evolution
EVOLUTION_INSTANCE=ml-agent
# Postgres da Evolution API v2 (obrigatório — sem ele o container reinicia com
# "Database provider invalid"). Em produção use senha forte (openssl rand -hex 24).
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=troque-por-senha-forte

# Opcional: URL que a Evolution chama ao desconectar. Em compose interno
# (EVOLUTION_URL=http://evolution:8080) o agente monta http://agent:PORT/webhook/evolution.
# EVOLUTION_WEBHOOK_URL=http://agent:3001/webhook/evolution

# URL pública do agente (OAuth do ML + fallback de webhook).
# Em VPS OBRIGATÓRIO — sem isso o painel esconde o botão OAuth (evita localhost).
# Ex.: https://srv1871121.hstgr.cloud  (mesmo host do Caddy / DOMINIO)
# PUBLIC_URL=https://seudominio.com

# --- Dashboard (Vercel / local) ---
# URL pública (ou local) da API do agente
AGENT_URL=http://localhost:3001
