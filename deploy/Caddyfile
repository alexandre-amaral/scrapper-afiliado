# ============================================================================
# deploy/Caddyfile — HTTPS automático na frente do painel
#
# O Caddy emite e renova o certificado Let's Encrypt sozinho, desde que o
# domínio em DOMINIO resolva para o IP desta máquina e as portas 80 e 443
# estejam abertas.
#
# Usado por docker-compose.prod.yml, que injeta DOMINIO a partir do .env.prod.
#
# ATENÇÃO: aqui publica-se o PAINEL, nunca o agente. O agente fica só na rede
# interna do compose — expor a API dele à internet daria acesso direto ao
# WhatsApp e às credenciais a quem tivesse o token.
# ============================================================================

{$DOMINIO} {
	reverse_proxy dashboard:3000

	encode gzip

	header {
		# Impede que o navegador tente HTTP depois da primeira visita.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# O painel não deve ser embutido em iframe de outro site (clickjacking).
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Não anuncia a versão do servidor.
		-Server
	}

	log {
		output stdout
		format console
	}
}
