# =====================================================================
# Dashboard (apps/dashboard) — variáveis de ambiente
#
# O dashboard é stateless: tudo que ele exibe e grava passa pela API
# REST do agente. Estas variáveis são usadas SOMENTE no servidor
# (Server Components / Server Actions) — o token nunca chega ao client.
#
# Em produção (Vercel), configure as mesmas variáveis no painel do
# projeto: Settings → Environment Variables.
# =====================================================================

# URL base da API do agente (Fastify na VPS ou local).
# Local: http://localhost:3001  |  VPS: https://seudominio.com (mesmo host do painel)
AGENT_URL=http://localhost:3001

# Token Bearer usado para autenticar no agente (mesmo valor configurado
# no .env do apps/agent).
AGENT_TOKEN=troque-por-um-token-seguro
